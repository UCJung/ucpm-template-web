# prod 백업 설정 (템플릿)
#
# 설치 위치: /etc/<앱키>/prod-backup.env
# 소유·권한: root:<배포계정 그룹> 0640
# systemd·배포 훅·수동 실행이 모두 이 파일 하나를 참조함.
# 아래 <...> 값을 프로젝트 값으로 전부 치환한 뒤 설치함.

# 백업 저장 루트 절대경로 — 배포계정 소유, 0700
# 예시: /home/pntadmin/backups/myapp_prod
BACKUP_ROOT=<백업 저장 루트 절대경로, 예: /home/pntadmin/backups/myapp_prod>

# daily tier 보존 세트 수 — 1~9999 정수
# 예시: 7 (일 1회 기준 1주 보존)
BACKUP_RETENTION_DAILY=<일일 백업 보존 개수, 예: 7>

# prod DB 컨테이너명 — docker ps --filter name=... 로 확인
# 예시: myapp_prod_db
DB_CONTAINER=<prod DB 컨테이너명, 예: myapp_prod_db>

# 업로드 파일 Docker 볼륨명 — docker volume ls 로 확인 (compose 프로젝트명 접두사 포함)
# 예시: myapp-prod_myapp_prod_uploads
UPLOAD_VOLUME=<업로드 파일 Docker 볼륨명, 예: myapp-prod_myapp_prod_uploads>

# docker 실행 파일 절대경로 — which docker 로 확인
# 예시: /usr/bin/docker
DOCKER_COMMAND=<docker 실행 파일 절대경로, 예: /usr/bin/docker>

# 업로드 볼륨 아카이빙에 쓸 경량 이미지 — tar 포함, 서버에 사전 pull 필요
# 예시: alpine:3.20
ARCHIVE_IMAGE=<아카이빙용 경량 이미지 태그, 예: alpine:3.20>

# 외부 전송 정책 — false 고정. true 로 두면 스크립트가 정책 위반으로 중단함.
TRANSFER_ENABLED=false
